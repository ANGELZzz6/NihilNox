<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dash_background">

    <!-- Top Bar -->
    <RelativeLayout
        android:id="@+id/layoutTopBarProgresion"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnBackProgresion"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_lifestream_white"
            android:rotation="90"
            app:tint="@color/dash_primary"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/btnBackProgresion"
            android:layout_toStartOf="@id/btnCalendarioProgresion"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:text="PROGRESIÓN"
            android:textColor="@color/dash_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:maxLines="1"
            android:ellipsize="end"/>

        <ImageButton
            android:id="@+id/btnCalendarioProgresion"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_toStartOf="@id/btnOpcionesProgresion"
            android:layout_centerVertical="true"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_calendar"
            app:tint="@color/dash_primary"/>

        <ImageButton
            android:id="@+id/btnOpcionesProgresion"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_toStartOf="@id/btnAgregarEjercicio"
            android:layout_centerVertical="true"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/dash_primary"/>

        <ImageButton
            android:id="@+id/btnAgregarEjercicio"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_plus"
            app:tint="@color/dash_primary"/>
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layoutTopBarProgresion"
        android:paddingBottom="80dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Buscador de Ejercicio -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutBusquedaEjercicio"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="Buscar ejercicio..."
                app:boxStrokeColor="@color/dash_primary"
                app:hintTextColor="@color/dash_primary"
                android:textColorHint="@color/dash_outline"
                app:endIconTint="@color/dash_primary">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/autoCompleteEjercicios"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="@color/white"
                    android:padding="16dp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Card de Detalles Técnicos -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDetallesTecnicos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/dash_surface_high"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/dash_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/tvDetalleDescanso"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="⏳ Descanso: 120s"
                            android:textColor="@color/dash_secondary_gold"
                            android:textSize="11sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:id="@+id/tvDetalleTempo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="⏱️ Tempo: 3-1-1"
                            android:textColor="@color/dash_tertiary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:gravity="end"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDetalleCalentamiento"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="🔥 Calentamiento: Barra vacía x10..."
                        android:textColor="@color/white"
                        android:textSize="11sp"/>

                    <TextView
                        android:id="@+id/tvDetalleNotasTendon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="⚠️ Tendón: Evitar rebote abajo"
                        android:textColor="@color/dash_error"
                        android:textSize="10sp"
                        android:textStyle="italic"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Contenedor de Series -->
            <LinearLayout
                android:id="@+id/layoutSeriesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

            <!-- Botones Series Dinámicas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuitarSerie"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="- Quitar Serie"
                    android:textColor="@color/dash_error"
                    android:textSize="12sp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAnadirSerie"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ Añadir Serie"
                    android:textColor="@color/dash_primary"
                    android:textSize="12sp"/>
            </LinearLayout>

            <!-- Molestia Articular -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/dash_surface_high"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MOLESTIA ARTICULAR / TENDÓN"
                            android:textColor="@color/dash_on_surface_variant"
                            android:textSize="10sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:id="@+id/tvValorMolestia"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="0/10"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"/>
                    </RelativeLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderMolestia"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:valueFrom="0"
                        android:valueTo="10"
                        android:stepSize="1"
                        app:thumbColor="@color/dash_on_primary_container"
                        app:trackColorActive="@color/dash_on_primary_container"
                        app:trackColorInactive="@color/dash_surface_low"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Notas -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Notas de la sesión"
                app:hintTextColor="@color/dash_primary"
                app:boxStrokeColor="@color/dash_primary"
                android:textColorHint="@color/dash_outline"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNotasProgresion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textColorHint="@color/dash_outline"
                    android:inputType="textMultiLine"
                    android:minLines="2"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Botón Guardar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardarSesion"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="24dp"
                android:text="GUARDAR SESIÓN"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                android:backgroundTint="@color/dash_secondary_gold"
                android:textColor="#1A1200"/>

            <!-- Historial Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="8dp"
                android:text="HISTORIAL RECIENTE"
                android:textColor="@color/dash_outline"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Header de Tabla -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="8dp"
                        android:background="@color/dash_surface_low">

                        <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="Fecha" android:textColor="@color/dash_outline" android:textStyle="bold" android:textSize="10sp"/>
                        <TextView android:layout_width="120dp" android:layout_height="wrap_content" android:text="Ejercicio" android:textColor="@color/dash_outline" android:textStyle="bold" android:textSize="10sp"/>
                        <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="Serie 1" android:textColor="@color/dash_outline" android:textStyle="bold" android:textSize="10sp" android:gravity="center"/>
                        <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="Serie 2" android:textColor="@color/dash_outline" android:textStyle="bold" android:textSize="10sp" android:gravity="center"/>
                        <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="Serie 3" android:textColor="@color/dash_outline" android:textStyle="bold" android:textSize="10sp" android:gravity="center"/>
                        <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="Serie 4" android:textColor="@color/dash_outline" android:textStyle="bold" android:textSize="10sp" android:gravity="center"/>
                        <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="Serie 5" android:textColor="@color/dash_outline" android:textStyle="bold" android:textSize="10sp" android:gravity="center"/>
                        <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="Serie 6" android:textColor="@color/dash_outline" android:textStyle="bold" android:textSize="10sp" android:gravity="center"/>
                        <TextView android:layout_width="60dp" android:layout_height="wrap_content" android:text="RIR" android:textColor="@color/dash_outline" android:textStyle="bold" android:textSize="10sp" android:gravity="center"/>
                        <TextView android:layout_width="60dp" android:layout_height="wrap_content" android:text="Mol." android:textColor="@color/dash_outline" android:textStyle="bold" android:textSize="10sp" android:gravity="center"/>
                        <TextView android:layout_width="200dp" android:layout_height="wrap_content" android:text="Notas" android:textColor="@color/dash_outline" android:textStyle="bold" android:textSize="10sp"/>
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvHistorialProgresion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"/>

                </LinearLayout>
            </HorizontalScrollView>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
