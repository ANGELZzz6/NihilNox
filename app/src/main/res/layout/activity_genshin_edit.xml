<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/back_global">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DETALLES DEL PERSONAJE"
            android:textColor="#FFD700"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginBottom="24dp"/>

        <EditText
            android:id="@+id/etGenshinNombre"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Nombre del personaje"
            android:textColor="#FFFFFF"
            android:textColorHint="#555577"
            android:background="@drawable/chat_input_bg"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="16dp"
            android:inputType="textCapWords"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Spinner
                android:id="@+id/spGenshinElemento"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/chat_input_bg"/>

            <Spinner
                android:id="@+id/spGenshinRareza"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/chat_input_bg"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/etGenshinNivel"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:hint="Nivel (1-90)"
                android:textColor="#FFFFFF"
                android:textColorHint="#555577"
                android:background="@drawable/chat_input_bg"
                android:paddingStart="16dp"
                android:inputType="number"
                android:gravity="center_vertical"/>

            <EditText
                android:id="@+id/etGenshinConstelacion"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:hint="Constelación (0-6)"
                android:textColor="#FFFFFF"
                android:textColorHint="#555577"
                android:background="@drawable/chat_input_bg"
                android:paddingStart="16dp"
                android:inputType="number"
                android:gravity="center_vertical"/>
        </LinearLayout>

        <EditText
            android:id="@+id/etGenshinNotas"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="Notas, Build, Artefactos..."
            android:textColor="#FFFFFF"
            android:textColorHint="#555577"
            android:background="@drawable/chat_input_bg"
            android:padding="16dp"
            android:layout_marginBottom="24dp"
            android:gravity="top"
            android:inputType="textMultiLine"/>

        <Button
            android:id="@+id/btnGuardarGenshin"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="GUARDAR PERSONAJE"
            android:textColor="#1A1200"
            android:textStyle="bold"
            android:background="@drawable/btn_gacha_gold_gradient"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnEliminarGenshin"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="ELIMINAR"
            android:textColor="#FF4444"
            android:background="@drawable/btn_nav_gradient"
            android:visibility="gone"/>

    </LinearLayout>
</ScrollView>
