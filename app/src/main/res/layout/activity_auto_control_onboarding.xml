<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/back_global"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧠 Control de Impulsos y Enfoque"
            android:textColor="#FFD700"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Configura tu plan de optimización de dopamina para mejorar tu salud mental y rendimiento."
            android:textColor="#6666AA"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginBottom="28dp"/>

        <!-- Frecuencia -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Frecuencia actual" android:textColor="#AAAACC" android:textSize="13sp"
            android:layout_marginBottom="6dp"/>
        <Spinner android:id="@+id/spinnerFrecuencia"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:background="@drawable/btn_nav_gradient"
            android:paddingStart="12dp"
            android:layout_marginBottom="16dp"/>

        <!-- Objetivo -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Tu objetivo principal" android:textColor="#AAAACC" android:textSize="13sp"
            android:layout_marginBottom="6dp"/>
        <Spinner android:id="@+id/spinnerObjetivo"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:background="@drawable/btn_nav_gradient"
            android:paddingStart="12dp"
            android:layout_marginBottom="16dp"/>

        <!-- Triggers -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Identifica tus disparadores (Triggers)" android:textColor="#AAAACC" android:textSize="13sp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout android:id="@+id/containerTriggers"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginBottom="32dp">

            <CheckBox android:id="@+id/cbAburrimiento" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Aburrimiento" android:textColor="#FFFFFF" android:buttonTint="#FFD700"/>
            <CheckBox android:id="@+id/cbEstres" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Estrés / Ansiedad" android:textColor="#FFFFFF" android:buttonTint="#FFD700"/>
            <CheckBox android:id="@+id/cbSoledad" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Soledad" android:textColor="#FFFFFF" android:buttonTint="#FFD700"/>
            <CheckBox android:id="@+id/cbInsomnio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dificultad para dormir" android:textColor="#FFFFFF" android:buttonTint="#FFD700"/>
            <CheckBox android:id="@+id/cbSocial" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Redes Sociales / Contenido sugestivo" android:textColor="#FFFFFF" android:buttonTint="#FFD700"/>
        </LinearLayout>

        <Button android:id="@+id/btnGenerarPlan"
            android:layout_width="match_parent" android:layout_height="58dp"
            android:text="Generar mi Plan ✦"
            android:textColor="#1A1200" android:textSize="16sp" android:textStyle="bold"
            android:background="@drawable/btn_gacha_gold_gradient"
            android:stateListAnimator="@null"/>

        <ProgressBar android:id="@+id/progressLoading"
            android:layout_width="48dp" android:layout_height="48dp"
            android:layout_gravity="center" android:visibility="gone"
            android:indeterminateTint="#FFD700"
            android:layout_marginTop="16dp"/>

    </LinearLayout>
</ScrollView>
