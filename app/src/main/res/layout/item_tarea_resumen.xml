<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardBackgroundColor="#1E1E1E"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <View
            android:id="@+id/viewColorTarea"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="#FFD700"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTareaTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Título de la tarea"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTareaInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10:30 AM · Diariamente"
                android:textColor="#AAAAAA"
                android:textSize="12sp" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/cbTareaCompletada"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="#FFD700" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
