<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dash_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNav"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- ── Top Bar ────────────────────────────────────────────────── -->
            <RelativeLayout
                android:id="@+id/layoutTopBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="24dp">

                <FrameLayout
                    android:id="@+id/flDashAvatar"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_alignParentStart="true"
                    android:background="@drawable/bg_avatar_border">

                    <TextView
                        android:id="@+id/tvDashAvatarEmoji"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="👤"
                        android:textSize="32sp"
                        android:gravity="center"
                        android:background="@drawable/avatar_background"/>

                    <ImageView
                        android:id="@+id/ivDashAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="@drawable/avatar_background"
                        android:visibility="gone"/>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_toEndOf="@id/flDashAvatar"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:id="@+id/tvDashNick"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bienvenido"
                        android:textColor="@color/dash_primary"
                        android:textSize="22sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PANEL DE CONTROL"
                        android:textColor="@color/dash_on_surface_variant"
                        android:textSize="10sp"
                        android:letterSpacing="0.1"/>
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnSettings"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_card_bento"
                    android:src="@drawable/ic_settings"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    app:tint="@color/dash_primary"/>
            </RelativeLayout>

            <!-- ── Gacha Banner ────────────────────────────────────────────── -->
            <FrameLayout
                android:id="@+id/btnDashGacha"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_gacha_banner"
                android:clickable="true"
                android:focusable="true"
                android:elevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <View
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@color/black"
                        android:alpha="0.2"
                        android:layout_gravity="center_vertical" />

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="-40dp"
                        android:src="@drawable/ic_sparkles"
                        app:tint="@color/dash_secondary_gold"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="24dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Invocación Gacha"
                            android:textColor="#1A1200"
                            android:textSize="18sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RECLAMA TU DESTINO"
                            android:textColor="#1A1200"
                            android:alpha="0.7"
                            android:textSize="10sp"
                            android:letterSpacing="0.1"/>
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_lifestream_white"
                        app:tint="#1A1200"
                        android:rotation="-90"/>
                </LinearLayout>
            </FrameLayout>

            <!-- ── Main Bento Grid ─────────────────────────────────────────── -->
            <GridLayout
                android:id="@+id/layoutBento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2"
                android:layout_marginBottom="16dp"
                android:useDefaultMargins="true">

                <!-- Music Card -->
                <LinearLayout
                    android:id="@+id/btnDashReproductor"
                    android:layout_width="0dp"
                    android:layout_height="140dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_card_bento"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_music"
                            app:tint="@color/dash_tertiary"/>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:orientation="horizontal"
                            android:gravity="bottom">
                            <View android:layout_width="3dp" android:layout_height="8dp" android:background="@color/dash_tertiary" android:layout_marginEnd="2dp"/>
                            <View android:layout_width="3dp" android:layout_height="14dp" android:background="@color/dash_tertiary" android:layout_marginEnd="2dp"/>
                            <View android:layout_width="3dp" android:layout_height="10dp" android:background="@color/dash_tertiary"/>
                        </LinearLayout>
                    </RelativeLayout>

                    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reproductor"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CYBERPUNK LOFI"
                        android:textColor="@color/dash_on_surface_variant"
                        android:textSize="9sp"/>
                </LinearLayout>

                <!-- Notes Card -->
                <LinearLayout
                    android:id="@+id/btnDashBlockNotas"
                    android:layout_width="0dp"
                    android:layout_height="140dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_card_bento"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_secure_note"
                            app:tint="@color/dash_primary"/>
                        <TextView
                            android:id="@+id/tvCountNotas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="12 NOTAS"
                            android:textColor="@color/dash_on_primary_container"
                            android:textSize="9sp"
                            android:textStyle="bold"/>
                    </RelativeLayout>

                    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bloc de Notas"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="IDEAS Y PENSAMIENTOS"
                        android:textColor="@color/dash_on_surface_variant"
                        android:textSize="9sp"/>
                </LinearLayout>

                <!-- Nutrition Card (Full Width) -->
                <RelativeLayout
                    android:id="@+id/btnDashNutricion"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_columnSpan="2"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_card_bento"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/ivNutriIcon"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/ic_health"
                        android:background="@drawable/bg_avatar_border"
                        android:backgroundTint="@color/dash_surface_high"
                        android:padding="10dp"
                        app:tint="@color/dash_error"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_toEndOf="@id/ivNutriIcon"
                        android:layout_marginStart="12dp"
                        android:layout_centerVertical="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nutrición &amp; Salud"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            android:textStyle="bold"/>

                        <ProgressBar
                            android:id="@+id/progressNutriDash"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="120dp"
                            android:layout_height="6dp"
                            android:layout_marginTop="4dp"
                            android:progress="65"
                            android:progressTint="@color/dash_secondary_gold"
                            android:progressBackgroundTint="@color/dash_surface_low"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_alignParentEnd="true"
                        android:gravity="end"
                        android:layout_centerVertical="true">

                        <TextView
                            android:id="@+id/tvCalDash"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1,840"
                            android:textColor="@color/dash_secondary_gold"
                            android:textSize="18sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="KCAL"
                            android:textColor="@color/dash_on_surface_variant"
                            android:textSize="9sp"
                            android:letterSpacing="0.1"/>
                    </LinearLayout>
                </RelativeLayout>
            </GridLayout>

            <!-- ── Middle List ─────────────────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/layoutLista"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <!-- Perfil -->
                <RelativeLayout
                    android:id="@+id/btnDashPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_card_bento"
                    android:layout_marginBottom="8dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <ImageView
                        android:id="@+id/ic1"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_user"
                        app:tint="@color/dash_primary"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@id/ic1"
                        android:layout_marginStart="16dp"
                        android:text="Mi Perfil"
                        android:textColor="@color/white"
                        android:textSize="15sp"/>
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_lifestream_white"
                        android:rotation="-90"
                        app:tint="@color/dash_outline"/>
                </RelativeLayout>

                <!-- Fall -->
                <RelativeLayout
                    android:id="@+id/btnDashFall"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_card_bento"
                    android:layout_marginBottom="8dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <ImageView
                        android:id="@+id/ic2"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_skull"
                        app:tint="@color/dash_tertiary"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@id/ic2"
                        android:layout_marginStart="16dp"
                        android:text="FALL"
                        android:textColor="@color/white"
                        android:textSize="15sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="ACTIVE"
                        android:textColor="@color/dash_tertiary"
                        android:background="@color/dash_surface_high"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:textSize="9sp"
                        android:textStyle="bold"/>
                </RelativeLayout>

                <!-- Academia -->
                <RelativeLayout
                    android:id="@+id/btnDashLearn"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_card_bento"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <ImageView
                        android:id="@+id/ic3"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_learn"
                        app:tint="@color/dash_primary"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@id/ic3"
                        android:layout_marginStart="16dp"
                        android:text="Academia"
                        android:textColor="@color/white"
                        android:textSize="15sp"/>
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_lifestream_white"
                        android:rotation="-90"
                        app:tint="@color/dash_outline"/>
                </RelativeLayout>
            </LinearLayout>

            <!-- ── Secondary Grid ─────────────────────────────────────────── -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:layout_marginBottom="16dp"
                android:useDefaultMargins="true">

                <LinearLayout
                    android:id="@+id/btnHabitos"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_card_bento"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:backgroundTint="@color/dash_surface_low">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_habitos_white"
                        app:tint="@color/dash_secondary_gold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Hábitos"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/tvHabitoProg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PROGRESS: 85%"
                        android:textColor="@color/dash_on_surface_variant"
                        android:textSize="8sp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnDashCalendario"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_card_bento"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:backgroundTint="@color/dash_surface_low">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_calendar"
                        app:tint="@color/dash_primary"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Calendario"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/tvTaskDash"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3 TAREAS HOY"
                        android:textColor="@color/dash_on_surface_variant"
                        android:textSize="8sp"/>
                </LinearLayout>
            </GridLayout>

            <!-- ── Social Section ──────────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="40dp">

                <LinearLayout
                    android:id="@+id/btnDashLifeStream"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_card_bento"
                    android:backgroundTint="#1A8D8BA3"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_sparkles"
                        app:tint="@color/dash_primary"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="LIFE STREAM"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnDashGames"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_card_bento"
                    android:backgroundTint="#1ADCBCFF"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_music"
                        app:tint="@color/dash_tertiary"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="GAMES"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ── API Config ──────────────────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/btnDashApiKeys"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:padding="12dp"
                android:layout_marginBottom="60dp"
                android:gravity="center">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/dash_outline"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Configuración API"
                    android:textColor="@color/dash_outline"
                    android:textSize="12sp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ── Bottom Navigation ────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_bottom_nav"
        android:orientation="horizontal"
        android:elevation="8dp"
        android:gravity="center">

        <LinearLayout
            android:id="@+id/navDash"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_sparkles"
                app:tint="@color/dash_primary"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DASH"
                android:textColor="@color/dash_primary"
                android:textSize="8sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navHabitos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_habitos_white"
                app:tint="@color/dash_outline"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HABITS"
                android:textColor="@color/dash_outline"
                android:textSize="8sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navNutricion"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_health"
                app:tint="@color/dash_outline"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HEALTH"
                android:textColor="@color/dash_outline"
                android:textSize="8sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navNotas"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_secure_note"
                app:tint="@color/dash_outline"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOTES"
                android:textColor="@color/dash_outline"
                android:textSize="8sp"/>
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
