<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="@color/dash_surface_high"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/dash_outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvNumeroSerie"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SERIE 1"
            android:textColor="@color/dash_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"/>

        <!-- Peso Slider -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tvLabelPeso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PESO"
                android:textColor="@color/dash_on_surface_variant"
                android:textSize="10sp"/>

            <LinearLayout
                android:id="@+id/layoutPesoContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvValorPeso"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="60.0 kg"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAumentarRangoPeso"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="12dp"
                    android:text="+20kg"
                    android:textColor="@color/dash_secondary_gold"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:padding="0dp"
                    android:minWidth="60dp"
                    app:strokeColor="@color/dash_secondary_gold"
                    app:cornerRadius="8dp"
                    app:rippleColor="@color/dash_secondary_gold"/>
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderPeso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/layoutPesoContainer"
                android:valueFrom="0"
                android:valueTo="200"
                android:stepSize="1.25"
                app:thumbColor="@color/dash_secondary_gold"
                app:trackColorActive="@color/dash_secondary_gold"
                app:trackColorInactive="@color/dash_surface_low"/>
        </RelativeLayout>

        <!-- Reps Slider -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tvLabelReps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REPETICIONES"
                android:textColor="@color/dash_on_surface_variant"
                android:textSize="10sp"/>

            <TextView
                android:id="@+id/tvValorReps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="10"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderReps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvValorReps"
                android:valueFrom="0"
                android:valueTo="30"
                android:stepSize="1"
                app:thumbColor="@color/dash_tertiary"
                app:trackColorActive="@color/dash_tertiary"
                app:trackColorInactive="@color/dash_surface_low"/>
        </RelativeLayout>

        <!-- RIR Slider (Visible solo en la última serie) -->
        <RelativeLayout
            android:id="@+id/layoutRir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RIR (Esfuerzo)"
                android:textColor="@color/dash_on_surface_variant"
                android:textSize="10sp"/>

            <TextView
                android:id="@+id/tvValorRir"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="2"
                android:textColor="@color/dash_primary"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderRir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvValorRir"
                android:valueFrom="0"
                android:valueTo="5"
                android:stepSize="1"
                app:thumbColor="@color/dash_primary"
                app:trackColorActive="@color/dash_primary"
                app:trackColorInactive="@color/dash_surface_low"/>
        </RelativeLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
