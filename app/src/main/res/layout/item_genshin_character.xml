<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="#1A1A2E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@drawable/btn_nav_gradient">

        <TextView
            android:id="@+id/tvCharElemento"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:textSize="24sp"
            android:text="💧"
            android:background="@drawable/bubble_shadow"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_gravity="center_vertical">

            <TextView
                android:id="@+id/tvCharNombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Personaje"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvCharDetalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nivel 90 • C6"
                android:textColor="#AAAACC"
                android:textSize="12sp"/>

        </LinearLayout>

        <TextView
            android:id="@+id/tvCharRareza"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⭐⭐⭐⭐⭐"
            android:textColor="#FFD700"
            android:textSize="10sp"
            android:layout_gravity="top"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>
